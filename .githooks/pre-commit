#!/bin/sh
# Local secret scan before commit — mirrors the "secret-scan" CI job
# (.github/workflows/ci.yml), which is the actual enforcement point. This
# hook exists to catch a leaked secret before it ever reaches a shared
# branch, but never blocks a commit just because gitleaks isn't installed
# locally (that gap is exactly what CI is for).
set -e

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks not installed — skipping local secret scan (CI will still catch it)."
  echo "  Install: https://github.com/gitleaks/gitleaks#installing"
  exit 0
fi

gitleaks protect --staged --redact --config "$(git rev-parse --show-toplevel)/.gitleaks.toml"
