# Mallchain OS v14 — build-time configuration.
# Copy to .env.local for a local build, or set the variables in CI before
# `npm run build`. Vite inlines these at build time: the bundle you ship
# contains their values, so a build made against the wrong API origin has to
# be rebuilt, not reconfigured on the server.
#
# Read by src/services/config.ts.

# REQUIRED for production builds. Absolute origin of the backend API, no path,
# no trailing slash — services/config.ts throws during `vite build` if this is
# missing, and refuses a non-http(s) scheme or a trailing slash.
#   local stack:  http://localhost:4000
#   staging:      https://staging-api.mallchain.network
#   production:   https://api.<your-owned-domain>
# Do not put the static site's own origin here unless that host proxies /api
# to the backend; the SPA requests <VITE_API_BASE_URL>/api/... .
# Leave unset for `npm run dev` — the dev server proxies /api to
# http://localhost:4000 (vite.config.ts) and requests stay same-origin.
VITE_API_BASE_URL=

# A production build that points at localhost / 127.0.0.1 / ::1 refuses to
# start (config.ts), because such a bundle only works on the machine serving
# the backend. Set this to 1 only when that is the intention — a local
# `vite preview` smoke test or an offline demo — never for an uploaded build.
VITE_ALLOW_LOCAL_API=

# 'mainnet' | 'testnet' (default testnet).
# A build flag: it describes how this bundle was compiled, not which chain is
# running. The UI's network label comes from the node's own chainId
# (/api/blockchain/health via src/services/networkIdentity.ts); this value is
# only shown when the node has never answered, so an unset flag on a mainnet
# deployment appears as "testnet" to an offline user.
VITE_NETWORK=testnet

# Idle minutes advertised in the config contract (default 120).
# Not enforced by the app: the server signs the session with its own
# SESSION_TTL_MIN and the client counts down from the `expiresAt` it returns.
# Set the backend's SESSION_TTL_MIN to change when a session ends.
VITE_SESSION_TTL=120

# Chain parameters for signing in the browser (mallcoinTx.ts). Defaults match
# backend/src/config/index.js — change these only if the chain changed, and
# change the backend's CHAIN_ID / CHAIN_PREFIX / GAS_PRICE with them.
VITE_CHAIN_ID=mallchain-1
VITE_CHAIN_PREFIX=mall
VITE_GAS_PRICE=0.01stake
