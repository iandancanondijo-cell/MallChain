# ── Mallchain Mission Control v14 .env.example ──────────────────────────────────
# Frontend environment configuration for the Mallchain dashboard.
# Copy to .env and adjust. All variables are optional with sensible defaults.

# ───────────────────────────────────────────────────────────────────────────────
# API Configuration
# ───────────────────────────────────────────────────────────────────────────────

# Base URL for the real backend API service layer.
# - Leave empty to run fully local (store-driven simulation)
# - Set to http://localhost:4000 for local backend development
# - Set to https://api.mallchain.com for production backend
# - MUST be a valid HTTP(S) URL without trailing slash if set
# 
# When set, the API service will make real HTTP requests to this URL instead of
# using the local store. Socket.IO will also connect to this URL for real-time updates.
VITE_API_BASE_URL=

# ───────────────────────────────────────────────────────────────────────────────
# Demo Mode Configuration
# ───────────────────────────────────────────────────────────────────────────────

# Demo mode: true enables realistic demo data and simulated streams
# Set to false for production: store starts EMPTY and every module shows
# its proper empty state, ready to be filled by the API backend.
# 
# When VITE_API_BASE_URL is set, demo mode is automatically disabled
# (real backend data takes precedence over simulated data).
# 
# Valid values: true, false, 1, 0, yes, no
VITE_DEMO_MODE=true

# ───────────────────────────────────────────────────────────────────────────────
# Network Configuration
# ───────────────────────────────────────────────────────────────────────────────

# Network label shown in the UI and used for feature flags
# - testnet: test environment, displays testnet UI elements and warnings
# - mainnet: production environment
# Default: testnet
VITE_NETWORK=testnet

# ───────────────────────────────────────────────────────────────────────────────
# Session Configuration
# ───────────────────────────────────────────────────────────────────────────────

# Session TTL (Time To Live) in minutes before the authentication session expires.
# The frontend will redirect to login when this timeout is reached.
# Default: 120 minutes (2 hours)
# Valid values: positive integers only
VITE_SESSION_TTL=120
