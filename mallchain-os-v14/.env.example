# ── Mallchain Mission Control v14 .env.example ──────────────────────────────────
# Frontend environment configuration for the Mallchain dashboard.
# Copy to .env and adjust. All variables are optional with sensible defaults.

# ───────────────────────────────────────────────────────────────────────────────
# API Configuration
# ───────────────────────────────────────────────────────────────────────────────

# Base URL for the real backend API service layer.
# - Required for production builds (`npm run build` fails fast without it)
# - Set to http://localhost:4000 for local backend development
# - Set to https://api.mallchain.com for production backend
# - MUST be a valid HTTP(S) URL without trailing slash
#
# The API service and Socket.IO both use this URL for all requests/real-time
# updates — there is no local-simulation fallback.
VITE_API_BASE_URL=

# ───────────────────────────────────────────────────────────────────────────────
# Network Configuration
# ───────────────────────────────────────────────────────────────────────────────

# Network label shown in the UI and used for feature flags
# - testnet: test environment, displays testnet UI elements and warnings
# - mainnet: production environment
# Default: testnet
VITE_NETWORK=testnet

# ───────────────────────────────────────────────────────────────────────────────
# Chain Configuration (used for client-side transaction signing)
# ───────────────────────────────────────────────────────────────────────────────
# Must match the backend's CHAIN_ID / CHAIN_PREFIX / GAS_PRICE (see ../.env.example)
# or signed transactions will be rejected by the chain.

VITE_CHAIN_ID=mallchain-1
VITE_CHAIN_PREFIX=mall
VITE_GAS_PRICE=0.01stake

# ───────────────────────────────────────────────────────────────────────────────
# Session Configuration
# ───────────────────────────────────────────────────────────────────────────────

# Session TTL (Time To Live) in minutes before the authentication session expires.
# The frontend will redirect to login when this timeout is reached.
# Default: 120 minutes (2 hours)
# Valid values: positive integers only
VITE_SESSION_TTL=120
