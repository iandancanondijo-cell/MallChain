# Backend environment — EXAMPLE FILE (no real secrets; values are placeholders).
# The live environment lives in backend/.env (never committed). This file
# documents the variables of the tamper-evident audit-chain feature so new
# deployments know what to set. See docs/TAMPER_PROTECTION.md for what each
# one actually buys you.

# ── Audit-chain on-chain anchoring (src/jobs/auditChainAnchor.js) ──────────
# HMAC key signing the anchor-record self-chain (AnchorRegistry anchorHash).
# MISSING → anchors still chain and still work, but unsigned: integrity
# status reports "unanchored-mode". Generate one with e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ANCHOR_HMAC_SECRET=<generate-a-64-hex-random-string-never-commit-the-value>

# Mnemonic of the wallet that broadcasts the daily anchor memo-tx. Falls
# back to OPERATOR_MNEMONIC then TREASURY_MNEMONIC when unset. Note: the
# treasury may hold 0 balance and fee enforcement can reject the tx — the
# job records the attempt (status 'failed') and retries next run; anchors
# themselves never depend on the broadcast succeeding.
# AUDIT_ANCHOR_MNEMONIC=

# Override the daily anchor schedule (node-cron, UTC). Default: 00:15 daily.
# AUDIT_ANCHOR_CRON=15 0 * * *

# Anchor self-send amount/denom (the tx exists for its memo, not its value).
# AUDIT_ANCHOR_AMOUNT=1000
# AUDIT_ANCHOR_DENOM=stake

# ── Related existing keys (documented in .env itself) ──────────────────────
# JWT_SECRET, OPERATOR_MNEMONIC, TREASURY_MNEMONIC, CHAIN_RPC, CHAIN_ID, ...

# ── Session policy (src/middleware/sessionCooldown.js) ─────────────────────
# 30 minutes of continuous use → automatic logout → 15-minute sign-in
# cooldown; login attempts during the cooldown are rejected (423) with the
# remaining time. SESSION_TTL_MIN is clamped server-side to 30–480 minutes.
# Changes require a backend restart (nodemon is not used).
SESSION_TTL_MIN=30
LOGIN_COOLDOWN_MINUTES=15

# ── Pending-task admin email notifier (src/jobs/pendingTaskNotifier.js) ─────
# Hourly digest to each category admin (validator / kyc / treasury / mining) of
# the open items needing THEIR review, plus a combined digest to every super
# admin. Counts mirror the adminPanel.js pending filters exactly. Emails send
# through Brevo (needs BREVO_API_KEY); with it unset they are logged only.
# Set PENDING_TASK_NOTIFY_ENABLED=0 to switch the notifier off, or DISABLE_CRON=1
# to turn off every scheduled job at once.
# PENDING_TASK_NOTIFY_ENABLED=1
# PENDING_TASK_NOTIFY_CRON=0 * * * *
# Re-announce a still-open queue that has NOT changed this many hours (new
# items always notify immediately regardless). Default 24.
# PENDING_TASK_NOTIFY_REMINDER_HOURS=24
# Redis TTL for the per-recipient cooldown snapshot. Default 30 days.
# PENDING_TASK_NOTIFY_TTL_SECONDS=2592000
# Base URL used to build the deep links in the digest. Default https://mallchain.network
# ADMIN_PANEL_URL=https://mallchain.network
