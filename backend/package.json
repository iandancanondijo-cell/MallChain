{
  "name": "marketplace-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "node -r dotenv/config src/index.js",
    "dev": "nodemon -r dotenv/config src/index.js",
    "wallet-service": "node wallet-service.js",
    "explorer:init-db": "node explorer/init-db.js",
    "explorer:indexer": "node explorer/indexer.js",
    "explorer:api": "node explorer/server.js",
    "explorer:dev": "nodemon explorer/server.js",
    "explorer:all": "concurrently \"npm run explorer:indexer\" \"npm run explorer:api\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@cosmjs/proto-signing": "^0.39.0",
    "@cosmjs/stargate": "^0.39.0",
    "@noble/curves": "^2.3.0",
    "@noble/hashes": "^2.3.0",
    "@scure/bip32": "^2.3.0",
    "axios": "^1.19.0",
    "bcryptjs": "^3.0.3",
    "bech32": "^2.0.0",
    "bip39": "^3.1.0",
    "bullmq": "^6.0.11",
    "cors": "^2.8.6",
    "csurf": "^1.11.0",
    "dotenv": "^17.2.3",
    "elliptic": "^6.6.1",
    "ethers": "^6.17.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "joi": "^18.2.3",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.2",
    "morgan": "^1.11.0",
    "passport": "^0.7.0",
    "pg": "^8.23.0",
    "prom-client": "^15.1.3",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "eslint": "^10.8.1",
    "jest": "^30.4.2",
    "nodemon": "^3.1.11",
    "supertest": "^7.2.2"
