{
  "name": "marketplace-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "node -r dotenv/config -r ./src/tracing.js src/index.js",
    "dev": "nodemon -r dotenv/config -r ./src/tracing.js src/index.js",
    "wallet-service": "node wallet-service.js",
    "explorer:init-db": "node explorer/init-db.js",
    "explorer:indexer": "node explorer/indexer.js",
    "explorer:api": "node explorer/server.js",
    "explorer:dev": "nodemon explorer/server.js",
    "explorer:all": "concurrently \"npm run explorer:indexer\" \"npm run explorer:api\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:load": "k6 run load-tests/api-load-test.js",
    "test:load:stress": "k6 run --vus 100 --duration 2m load-tests/api-load-test.js"
  },
  "dependencies": {
    "@cosmjs/amino": "^0.39.0",
    "@cosmjs/crypto": "^0.39.0",
    "@cosmjs/encoding": "^0.39.0",
    "@cosmjs/proto-signing": "^0.39.0",
    "@cosmjs/stargate": "^0.39.0",
    "@dr.pogodin/csurf": "~1.18.2",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-node": "^0.83.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.0",
    "@opentelemetry/resources": "^3.1.0",
    "@opentelemetry/sdk-node": "^0.301.0",
    "@opentelemetry/semantic-conventions": "^1.45.0",
    "@scure/bip32": "^2.4.0",
    "axios": "^1.21.0",
    "bcryptjs": "^3.0.3",
    "bech32": "^2.0.0",
    "bip39": "^3.1.2",
    "bullmq": "^6.7.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "elliptic": "^6.6.1",
    "ethers": "^6.0.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "joi": "^18.3.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.0",
    "morgan": "^1.10.1",
    "multer": "^2.5.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.4.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "sanitize-html": "^2.18.1",
    "socket.io": "^4.8.4",
    "uuid": "^14.0.3",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@babel/core": "^8.1.0",
    "@babel/preset-env": "^8.0.7",
    "babel-jest": "^30.5.2",
    "concurrently": "^10.0.7",
    "eslint": "^10.14.0",
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.11",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.2"
  }
}
