# ── Mallchain Backend .env.example ──────────────────────────────────────────────
# Copy this file to .env and fill in real values for your environment.
# Never commit .env to git—it contains secrets.
# For production, ensure all secrets are at least 32 characters.

# ───────────────────────────────────────────────────────────────────────────────
# Server Configuration
# ───────────────────────────────────────────────────────────────────────────────

# Node environment: development, production, or test
# Used to determine whether to enforce strict validation and security defaults
NODE_ENV=development

# ───────────────────────────────────────────────────────────────────────────────
# Database Configuration (MongoDB)
# ───────────────────────────────────────────────────────────────────────────────

# MongoDB connection string in format: mongodb://[user:password@]host:port/database
# Example: mongodb://localhost:27017/marketplace
# For production: use MongoDB Atlas or managed MongoDB service
MONGO_URI=mongodb://localhost:27017/marketplace

# MongoDB connection pool settings (optional)
MONGO_MAX_POOL_SIZE=20          # Maximum number of database connections
MONGO_MIN_POOL_SIZE=5           # Minimum number of database connections (default: 1)
MONGO_SOCKET_TIMEOUT_MS=30000   # Socket timeout in milliseconds
MONGO_CONNECT_TIMEOUT_MS=10000  # Connection timeout in milliseconds
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000  # Server selection timeout in milliseconds

# TLS in transit (production-readiness E3). A mongodb+srv:// Atlas URI
# implies TLS on its own; a self-hosted TLS-enabled mongod, or a plain
# mongodb:// Atlas-style URI, needs this set explicitly.
MONGO_TLS=false
# MONGO_TLS_CA_FILE=/path/to/ca.pem              # only for a self-signed/private-CA server
# MONGO_TLS_CERT_KEY_FILE=/path/to/client.pem     # only if the server requires a client certificate (mTLS)
# MONGO_TLS_ALLOW_INVALID_CERTIFICATES=false      # never set true in production

# ───────────────────────────────────────────────────────────────────────────────
# Cache Configuration (Redis)
# ───────────────────────────────────────────────────────────────────────────────

# Redis host (localhost for development, managed Redis service for production)
REDIS_HOST=localhost

# Redis port (default: 6379)
REDIS_PORT=6379

# Redis AUTH password. REQUIRED in production — without it, any network-reachable
# client can read/write all cached data, JWT denylists, and BullMQ job queues.
# In development, leave unset to run without AUTH.
REDIS_PASSWORD=

# Enable Redis for rate limiting (should be true in production)
RATE_LIMIT_REDIS=true

# TLS in transit (production-readiness E3) — most managed Redis providers
# (ElastiCache in-transit encryption, Redis Cloud, Upstash) enable this by
# default; a self-hosted TLS Redis needs REDIS_TLS_CA_FILE pointed at its CA.
REDIS_TLS=false
# REDIS_TLS_CA_FILE=/path/to/ca.pem
# REDIS_TLS_CERT_FILE=/path/to/client-cert.pem
# REDIS_TLS_KEY_FILE=/path/to/client-key.pem
# REDIS_TLS_REJECT_UNAUTHORIZED=true              # never set false in production

# ───────────────────────────────────────────────────────────────────────────────
# Authentication Secrets
# ───────────────────────────────────────────────────────────────────────────────
# WARNING: These must be strong random secrets. Generate with:
# openssl rand -hex 16  (32-character hex string = 128 bits)
# In production, these MUST be at least 32 characters long.

# JWT secret for signing authentication tokens (used for /api/auth endpoints)
# MUST be >= 32 characters for production. Used to verify tokens on protected routes.
JWT_SECRET=REPLACE_WITH_RANDOM_32PLUS_CHAR_SECRET

# Session secret for encrypting session data
# MUST be >= 32 characters for production.
SESSION_SECRET=REPLACE_WITH_RANDOM_32PLUS_CHAR_SECRET

# Admin API key for protected admin endpoints
# MUST be >= 32 characters for production.
ADMIN_API_KEY=REPLACE_WITH_RANDOM_32PLUS_CHAR_SECRET

# Payment webhook secret. REQUIRED in production (NODE_ENV=production) —
# without it, /api/buy/mpesa/callback and /api/buy/payout/callback accept
# unauthenticated requests. Safaricom can't sign webhook payloads, so this
# secret is appended as a ?token= query param on the CALLBACK_URL /
# PAYOUT_CALLBACK_URL registered with them, and verified on every callback.
PAYMENT_WEBHOOK_SECRET=REPLACE_WITH_PROVIDER_WEBHOOK_SECRET

# Field-level encryption for sensitive PII at rest (KYC identity documents,
# user phone/email/wallet address — see utils/fieldEncryption.js). Two
# DIFFERENT 32-byte (64 hex char) keys — reusing one key for both would let
# whoever holds the more-exposed blind-index key also decrypt the data.
# MUST be set in production. Generate each with: openssl rand -hex 32
FIELD_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHAR_KEY
FIELD_BLIND_INDEX_KEY=REPLACE_WITH_A_DIFFERENT_64_HEX_CHAR_KEY

# ───────────────────────────────────────────────────────────────────────────────
# CORS and Frontend Configuration
# ───────────────────────────────────────────────────────────────────────────────

# Frontend URL (used for CORS headers and redirects)
# Development: http://localhost:5173 (Vite default)
# Production: your actual frontend domain (e.g., https://app.mallchain.com)
FRONTEND_URL=http://localhost:5173

# Alternate frontend URL (e.g., for Mines frontend on different port)
MINES_FRONTEND_URL=http://localhost:5176

# Additional allowed CORS origins (comma-separated list, optional)
# Leave empty to allow only FRONTEND_URL and MINES_FRONTEND_URL
# Example: https://api.example.com,https://dashboard.example.com
CORS_ORIGINS=

# REQUIRED in production: the reverse proxy/CDN CIDR range(s) Express should
# trust for X-Forwarded-For (comma-separated, e.g. 10.0.0.0/8 for an internal
# ALB, or your CDN's published IP ranges). If unset, the server falls back to
# trusting exactly one hop, which is only correct if that one upstream is
# genuinely not reachable directly by clients.
TRUST_PROXY=

# Public backend URL (used in API responses and redirects)
# Development: http://localhost:4000
# Production: your actual backend domain (e.g., https://api.mallchain.com)
BACKEND_PUBLIC_URL=http://localhost:4000

# ───────────────────────────────────────────────────────────────────────────────
# Blockchain (Cosmos SDK) Configuration
# ───────────────────────────────────────────────────────────────────────────────

# Chain ID (identifies your blockchain network)
# Testnet: mallchain-testnet-1 or similar
# Mainnet: mallchain-1
CHAIN_ID=mallchain-1

# Chain address prefix (used to format blockchain addresses)
# Example: mall (addresses look like mall1abc123...)
CHAIN_PREFIX=mall

# Base denomination (smallest unit of the blockchain token)
CHAIN_BASE_DENOM=stake

# Gas price for transactions (example: 0.01stake means 0.01 of base denom per gas)
GAS_PRICE=0.01stake

# Blockchain RPC endpoint (for transaction broadcasting and chain state queries)
# Local development: http://localhost:26657
# Public testnet: consult your chain's documentation
CHAIN_RPC=http://localhost:26657

# Blockchain REST endpoint (alternative to RPC, used for some queries)
# Local development: http://localhost:1317
# Public testnet: consult your chain's documentation
CHAIN_REST=http://localhost:1317

# Broadcast mode for transactions: BROADCAST_MODE_SYNC, BROADCAST_MODE_ASYNC, BROADCAST_MODE_BLOCK
# SYNC: wait for transaction to be included in the mempool (recommended)
# ASYNC: return immediately without waiting
# BLOCK: wait for transaction to be included in a block (slowest)
BROADCAST_MODE=BROADCAST_MODE_SYNC

# Transaction confirmation timeout in milliseconds (how long to wait for confirmation)
TX_CONFIRM_TIMEOUT_MS=120000

# Polling interval when checking transaction status (in milliseconds)
TX_POLL_INTERVAL_MS=2000

# Interval for blockchain listener to poll for new blocks (in milliseconds)
BLOCKCHAIN_LISTENER_INTERVAL_MS=3000

# ───────────────────────────────────────────────────────────────────────────────
# Rate Limiting Configuration
# ───────────────────────────────────────────────────────────────────────────────

# Time window for rate limiting (in milliseconds)
# 60000 = 1 minute
RATE_LIMIT_WINDOW_MS=60000

# Maximum API requests per IP per window (120 requests/minute)
RATE_LIMIT_MAX=120

# Maximum transaction endpoint requests per IP per window (40 requests/minute)
# Lower than general API to prevent transaction spam
RATE_LIMIT_TX_MAX=40

# ───────────────────────────────────────────────────────────────────────────────
# Wallet Service Configuration (optional)
# ───────────────────────────────────────────────────────────────────────────────

# Enable wallet service (if false, wallet-specific endpoints are disabled)
WALLET_SERVICE_ENABLED=true

# Port for wallet service (separate service that can be on different host)
WALLET_SERVICE_PORT=4001

# Host to bind wallet service to (127.0.0.1 = localhost only)
WALLET_SERVICE_HOST=127.0.0.1

# ───────────────────────────────────────────────────────────────────────────────
# Faucet Configuration (for distributing test tokens on testnet)
# ───────────────────────────────────────────────────────────────────────────────
# WARNING: Never use mainnet accounts. These are testnet faucet credentials only.

# Private key for faucet account in hex format (only needed if FAUCET_ENABLED=true)
FAUCET_PRIVATE_KEY_HEX=REPLACE_WITH_LOCAL_DEV_FAUCET_PRIVATE_KEY_HEX

# Enable faucet endpoint for users to request test tokens
FAUCET_ENABLED=true

# Mnemonic (seed phrase) for faucet account (if not using private key)
# Should be a funded account on your testnet
FAUCET_MNEMONIC=REPLACE_WITH_FUNDED_TESTNET_MNEMONIC

# Amount of MLCNS to give per faucet request
FAUCET_MLCNS_AMOUNT=1000

# Amount of stake tokens to give per faucet request
FAUCET_STAKE_AMOUNT=100

# Maximum total MLCNS that can be distributed from faucet (total cap)
FAUCET_MAX_MLCNS=10000

# Cooldown between faucet requests per user (in milliseconds)
FAUCET_COOLDOWN_MS=60000

# MLCNS/KES buy and sell price used only when the chain's live on-chain
# market price (x/mlcoin dynamic pricing) is unreachable. Matches the
# on-chain MarketPrice default (BuyPrice: 62, SellPrice: 58 => KES 0.62/0.58).
MLCNS_BUY_PRICE_KES=0.62
MLCNS_SELL_PRICE_KES=0.58

# Whether faucet should automatically fund transaction gas fees
FAUCET_FUND_GAS=true

# ───────────────────────────────────────────────────────────────────────────────
# Treasury and Operator Mnemonics (for server-side transaction signing)
# ───────────────────────────────────────────────────────────────────────────────
# WARNING: These are highly sensitive. Only set on secure, trusted nodes.
# NEVER commit these to git. Use secure secret management in production.

# Treasury signing in production is REQUIRED to go through HashiCorp Vault
# (see backend/src/utils/keyManager.js) — VAULT_ADDR + VAULT_TOKEN below.
# TREASURY_MNEMONIC is only ever read when TEST_MODE=true, and TEST_MODE is
# rejected outright in production (backend/src/config/index.js).
VAULT_ADDR=REPLACE_WITH_VAULT_ADDR
VAULT_TOKEN=REPLACE_WITH_VAULT_TOKEN
VAULT_SECRET_PATH=secret/data/marketplace/treasury

# AppRole auth (preferred over the static VAULT_TOKEN above) — a leaked
# AppRole secret_id is scoped to this role and its lease naturally expires;
# a leaked static token isn't. When both are set, AppRole wins. Requires the
# approle auth method to be enabled in Vault for this role.
VAULT_ROLE_ID=REPLACE_WITH_VAULT_APPROLE_ROLE_ID
VAULT_SECRET_ID=REPLACE_WITH_VAULT_APPROLE_SECRET_ID

# Retry/backoff tuning for transient Vault errors (429/5xx). Defaults are
# usually fine; lower VAULT_MAX_RETRIES in latency-sensitive paths if needed.
VAULT_MAX_RETRIES=3
VAULT_RETRY_BASE_DELAY_MS=200

# Treasury account mnemonic — local/TEST_MODE use only, never production.
TREASURY_MNEMONIC=REPLACE_WITH_TREASURY_MNEMONIC

# Operator account mnemonic (handles operator transactions)
OPERATOR_MNEMONIC=REPLACE_WITH_OPERATOR_MNEMONIC

# Allow operator mnemonic to be used for transaction signing (default: false for safety)
ALLOW_OPERATOR_MNEMONIC=false

# ───────────────────────────────────────────────────────────────────────────────
# Safaricom / M-Pesa Payment Integration (optional)
# ───────────────────────────────────────────────────────────────────────────────

# Safaricom API endpoint (sandbox for testing, production for live)
SAFARICOM_API=https://sandbox.safaricom.co.ke

# Safaricom Consumer Key (obtained from M-Pesa developer portal)
SAFARICOM_KEY=REPLACE_WITH_SAFARICOM_CONSUMER_KEY

# Safaricom Consumer Secret (obtained from M-Pesa developer portal)
SAFARICOM_SECRET=REPLACE_WITH_SAFARICOM_CONSUMER_SECRET

# Business short code (assigned by Safaricom, typically numeric)
BUSINESS_SHORT_CODE=174379

# M-Pesa passkey for STK push (authentication with Safaricom)
PASSKEY=REPLACE_WITH_SAFARICOM_PASSKEY

# Callback URL for M-Pesa STK push (where Safaricom posts transaction results)
CALLBACK_URL=http://localhost:4000/api/buy/mpesa/callback

# Callback URL for M-Pesa B2C payouts
PAYOUT_CALLBACK_URL=http://localhost:4000/api/buy/payout/callback

# B2C initiator name (identity for business-to-consumer transactions)
B2C_INITIATOR_NAME=testapi

# B2C security credential (encrypted password for B2C operations)
SECURITY_CREDENTIAL=REPLACE_WITH_B2C_SECURITY_CREDENTIAL

# B2C command ID (usually "BusinessPayment" or "SalaryPayment")
COMMAND_ID=BusinessPayment

# Enable automatic payout to users when they request withdrawals (default: false)
ENABLE_WITHDRAWAL_AUTO_PAYOUT=false

# Cashout receiver address (blockchain address where fees are collected)
# Example: mall1abc123def456...
CASHOUT_RECEIVER_ADDRESS=REPLACE_WITH_OPERATOR_OR_TREASURY_MALL_ADDRESS

# B2C payout caps (services/treasuryLimitsService.js) — a single payout
# above MAX_PAYOUT_KES_PER_TX, or one that would push today's cumulative
# total above MAX_PAYOUT_KES_PER_DAY, is held for manual admin review
# instead of being paid out automatically. Both are opt-in: unset means no
# cap at all (matches behavior before this existed). There is no safe
# universal default — set these to real figures based on your own
# risk/liquidity tolerance before relying on ENABLE_WITHDRAWAL_AUTO_PAYOUT.
MAX_PAYOUT_KES_PER_TX=
MAX_PAYOUT_KES_PER_DAY=

# ───────────────────────────────────────────────────────────────────────────────
# Badge system (streak-earned or purchased; gates Mallpoints conversion cadence)
# ───────────────────────────────────────────────────────────────────────────────

# How many consecutive active days the monthly snapshot (14th of each
# month) requires to earn a badge automatically.
BADGE_STREAK_REQUIRED_DAYS=7

# Price in KES to buy a badge directly instead of earning it via streak.
BADGE_PURCHASE_PRICE_KES=17

# Generic SMTP for badge/notification emails (optional — notifications
# degrade to in-app-only if unset). Works with any SMTP provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@mallchain.local
SMTP_SECURE=false

# Africa's Talking SMS (optional — notifications degrade to in-app-only if unset).
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=
AFRICASTALKING_SENDER_ID=

# WhatsApp Business API (Meta Cloud API) — optional, template messages only.
# Requires a WhatsApp Business Account approved by Meta. See backend/src/services/whatsappService.js.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v19.0
# Webhook verification token — must match the value configured in WhatsApp Business Manager.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ───────────────────────────────────────────────────────────────────────────────
# AML/sanctions screening (backend/src/services/amlProvider.js)
# ───────────────────────────────────────────────────────────────────────────────

# Real sanctions/PEP/watchlist provider (Chainalysis, TRM, ComplyAdvantage,
# etc.). Both unset -> falls back to a clearly-labeled mock provider in
# development; REQUIRED in production (server refuses to screen KYC
# submissions without a real provider configured — see amlProvider.js).
AML_PROVIDER_URL=
AML_PROVIDER_API_KEY=

# ───────────────────────────────────────────────────────────────────────────────
# Logging & alerting (utils/logger.js)
# ───────────────────────────────────────────────────────────────────────────────

# Service name attached to every structured log line.
SERVICE_NAME=blockchain-api

# Fire-and-forget alert on every logger.error() call — the PagerDuty-free
# option: a generic webhook URL, or a Slack incoming webhook (set
# ALERT_WEBHOOK_FORMAT=slack for Slack's {text: ...} payload shape instead
# of the raw structured log entry as JSON). Unset = no alerting at all.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_FORMAT=
# Throttle: at most one alert per this many ms for the same (context,
# message) pair, so a hot error loop can't become an alert storm.
ALERT_WEBHOOK_MIN_INTERVAL_MS=60000

# ───────────────────────────────────────────────────────────────────────────────
# Distributed tracing (src/tracing.js)
# ───────────────────────────────────────────────────────────────────────────────

# OpenTelemetry OTLP/HTTP collector endpoint, e.g. http://localhost:4318/v1/traces
# (a local otel-collector) or your APM vendor's OTLP ingest URL. Unset = tracing
# is entirely disabled — no SDK starts, no overhead, no console-exporter noise.
# Auto-instruments http/express/mongodb/ioredis/etc. — see src/tracing.js.
OTEL_EXPORTER_OTLP_ENDPOINT=

# ───────────────────────────────────────────────────────────────────────────────
# Testing and Development
# ───────────────────────────────────────────────────────────────────────────────

# Test mode: disables some production guards and enables debug features
# Set to true only during development/testing, never in production
TEST_MODE=false

# ───────────────────────────────────────────────────────────────────────────────
# docker-compose (repo root docker-compose.yml)
# ───────────────────────────────────────────────────────────────────────────────
# These are read by docker-compose itself from a .env file in this same
# directory — separate from the app-level vars above, which the backend
# container receives via docker-compose.yml's own `environment:` blocks.

# Root credential for the mongo service's initial admin account.
MONGO_ROOT_PASSWORD=REPLACE_WITH_RANDOM_32PLUS_CHAR_SECRET

# Password for the 'mallchain' application DB user that mongo-init.js
# creates on first boot — must match what the backend service's MONGO_URI
# connects with (docker-compose.yml wires this automatically).
MONGO_APP_PASSWORD=REPLACE_WITH_RANDOM_32PLUS_CHAR_SECRET

# Backend URL baked into the frontend's static bundle AT BUILD TIME (Vite
# env vars are not readable at container runtime) — set this to wherever
# the backend will actually be reachable from a user's browser, not the
# in-network service name.
VITE_API_BASE_URL=http://localhost:4000

# ───────────────────────────────────────────────────────────────────────────────
# PostgreSQL / Explorer Indexer
# ───────────────────────────────────────────────────────────────────────────────
# The standalone Explorer backend + block indexer require PostgreSQL.
# They are optional: without them, the backend still ships in-process
# explorer routes (routes/explorer.js, MongoDB-backed) for basic wallet
# functionality. When EXPLORER_ENABLED=true and EXPLORER_BACKEND_URL is
# set, the main backend consolidates explorer traffic by proxying
# /api/explorer/* (or a subset) to the standalone indexer so clients
# hit a single URL and port.

# Postgres connection parameters. Indexer service DB account.
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=mallchain_explorer
PG_PASSWORD=REPLACE_WITH_RANDOM_32PLUS_CHAR_SECRET
PG_DATABASE=mallchain_explorer
PG_SSLMODE=disable        # set to require / verify-full behind a real LB
PG_POOL_SIZE=20
PG_SCHEMA=public

# Full connection URI (optional; if set, it overrides the individual
# PG_HOST/PG_PORT/… vars above for services that prefer URI format).
# PG_URI=postgresql://mallchain_explorer:PASSWORD@127.0.0.1:5432/mallchain_explorer?sslmode=disable

# Explorer backend + indexer integration (C6 route consolidation proxy).
# Turn on when the standalone service is running (its startup depends on
# the Postgres credentials above).
EXPLORER_ENABLED=false
EXPLORER_BACKEND_URL=http://127.0.0.1:4100
# Prefix mounted on the main backend under which explorer requests are
# proxied. Matches the local route mount.
EXPLORER_PROXY_PREFIX=/api/explorer
# true = proxy every request under EXPLORER_PROXY_PREFIX to the
# standalone backend and disable the local routes/explorer.js entirely.
# false (default) = keep local routes for well-known user-facing paths and
# proxy only the indexer-only paths (blocks, consensus, validator RPCs).
EXPLORER_PROXY_ALL=false
# Timeout for individual upstream requests from the proxy.
EXPLORER_PROXY_TIMEOUT_MS=15000
# true = start the block indexer in the same Node process as the
# explorer backend. Set to false if you run the indexer as a separate
# container / cron / sidecar to avoid double-indexing.
EXPLORER_INDEXER_AUTOSTART=true

