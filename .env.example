# ── Mallchain .env.example ──────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# Never commit .env to git.

NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/marketplace
MONGO_MAX_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=5
MONGO_SOCKET_TIMEOUT_MS=30000
MONGO_CONNECT_TIMEOUT_MS=10000
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
RATE_LIMIT_REDIS=true

# Secrets — generate with: openssl rand -hex 64
JWT_SECRET=REPLACE_WITH_RANDOM_64_BYTE_HEX
SESSION_SECRET=REPLACE_WITH_RANDOM_64_BYTE_HEX
ADMIN_API_KEY=REPLACE_WITH_RANDOM_64_BYTE_HEX

# Payment webhook (set when using Mpesa or other providers)
PAYMENT_WEBHOOK_SECRET=REPLACE_WITH_PROVIDER_WEBHOOK_SECRET

# Frontend
FRONTEND_URL=http://localhost:5173
MINES_FRONTEND_URL=http://localhost:5176
CORS_ORIGINS=

# Chain
CHAIN_ID=mallchain-1
CHAIN_PREFIX=mall
CHAIN_BASE_DENOM=stake
GAS_PRICE=0.01stake
CHAIN_RPC=http://localhost:26657
CHAIN_REST=http://localhost:1317
BROADCAST_MODE=BROADCAST_MODE_SYNC
TX_CONFIRM_TIMEOUT_MS=120000
TX_POLL_INTERVAL_MS=2000
BLOCKCHAIN_LISTENER_INTERVAL_MS=3000

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
RATE_LIMIT_TX_MAX=40

# Wallet service
WALLET_SERVICE_ENABLED=true
WALLET_SERVICE_PORT=4001
WALLET_SERVICE_HOST=127.0.0.1

# Faucet — mnemonic for a funded account that distributes test tokens
# WARNING: keep these mnemonics secret and never use real funds on testnet accounts
FAUCET_ENABLED=true
FAUCET_MNEMONIC=REPLACE_WITH_FUNDED_TESTNET_MNEMONIC
FAUCET_MLCNS_AMOUNT=1000
FAUCET_STAKE_AMOUNT=100
FAUCET_MAX_MLCNS=10000
FAUCET_COOLDOWN_MS=60000
FAUCET_FUND_GAS=true

# Treasury / operator — only set on nodes that sign transactions server-side
TREASURY_MNEMONIC=REPLACE_WITH_TREASURY_MNEMONIC
OPERATOR_MNEMONIC=REPLACE_WITH_OPERATOR_MNEMONIC
ALLOW_OPERATOR_MNEMONIC=false

# Test mode — disables some production guards
TEST_MODE=false
