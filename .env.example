# ── Mallchain Backend .env.example ──────────────────────────────────────────────
# Copy this file to .env and fill in real values for your environment.
# Never commit .env to git—it contains secrets.
# For production, ensure all secrets are at least 32 characters.

# ───────────────────────────────────────────────────────────────────────────────
# Server Configuration
# ───────────────────────────────────────────────────────────────────────────────

# Node environment: development, production, or test
# Used to determine whether to enforce strict validation and security defaults
NODE_ENV=development

# ───────────────────────────────────────────────────────────────────────────────
# Database Configuration (MongoDB)
# ───────────────────────────────────────────────────────────────────────────────

# MongoDB connection string in format: mongodb://[user:password@]host:port/database
# Example: mongodb://localhost:27017/marketplace
# For production: use MongoDB Atlas or managed MongoDB service
MONGO_URI=mongodb://localhost:27017/marketplace

# MongoDB connection pool settings (optional)
MONGO_MAX_POOL_SIZE=20          # Maximum number of database connections
MONGO_MIN_POOL_SIZE=5           # Minimum number of database connections (default: 1)
MONGO_SOCKET_TIMEOUT_MS=30000   # Socket timeout in milliseconds
MONGO_CONNECT_TIMEOUT_MS=10000  # Connection timeout in milliseconds
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000  # Server selection timeout in milliseconds

# ───────────────────────────────────────────────────────────────────────────────
# Cache Configuration (Redis)
# ───────────────────────────────────────────────────────────────────────────────

# Redis host (localhost for development, managed Redis service for production)
REDIS_HOST=localhost

# Redis port (default: 6379)
REDIS_PORT=6379

# Enable Redis for rate limiting (should be true in production)
RATE_LIMIT_REDIS=true

# ───────────────────────────────────────────────────────────────────────────────
# Authentication Secrets
# ───────────────────────────────────────────────────────────────────────────────
# WARNING: These must be strong random secrets. Generate with:
# openssl rand -hex 16  (32-character hex string = 128 bits)
# In production, these MUST be at least 32 characters long.

# JWT secret for signing authentication tokens (used for /api/auth endpoints)
# MUST be >= 32 characters for production. Used to verify tokens on protected routes.
JWT_SECRET=REPLACE_WITH_RANDOM_32PLUS_CHAR_SECRET

# Session secret for encrypting session data
# MUST be >= 32 characters for production.
SESSION_SECRET=REPLACE_WITH_RANDOM_32PLUS_CHAR_SECRET

# Admin API key for protected admin endpoints
# MUST be >= 32 characters for production.
ADMIN_API_KEY=REPLACE_WITH_RANDOM_32PLUS_CHAR_SECRET

# Payment webhook secret (optional, set when using Mpesa or other providers)
# Validates webhook authenticity from payment processors
PAYMENT_WEBHOOK_SECRET=REPLACE_WITH_PROVIDER_WEBHOOK_SECRET

# ───────────────────────────────────────────────────────────────────────────────
# CORS and Frontend Configuration
# ───────────────────────────────────────────────────────────────────────────────

# Frontend URL (used for CORS headers and redirects)
# Development: http://localhost:5173 (Vite default)
# Production: your actual frontend domain (e.g., https://app.mallchain.com)
FRONTEND_URL=http://localhost:5173

# Alternate frontend URL (e.g., for Mines frontend on different port)
MINES_FRONTEND_URL=http://localhost:5176

# Additional allowed CORS origins (comma-separated list, optional)
# Leave empty to allow only FRONTEND_URL and MINES_FRONTEND_URL
# Example: https://api.example.com,https://dashboard.example.com
CORS_ORIGINS=

# Public backend URL (used in API responses and redirects)
# Development: http://localhost:4000
# Production: your actual backend domain (e.g., https://api.mallchain.com)
BACKEND_PUBLIC_URL=http://localhost:4000

# ───────────────────────────────────────────────────────────────────────────────
# Blockchain (Cosmos SDK) Configuration
# ───────────────────────────────────────────────────────────────────────────────

# Chain ID (identifies your blockchain network)
# Testnet: mallchain-testnet-1 or similar
# Mainnet: mallchain-1
CHAIN_ID=mallchain-1

# Chain address prefix (used to format blockchain addresses)
# Example: mall (addresses look like mall1abc123...)
CHAIN_PREFIX=mall

# Base denomination (smallest unit of the blockchain token)
CHAIN_BASE_DENOM=stake

# Gas price for transactions (example: 0.01stake means 0.01 of base denom per gas)
GAS_PRICE=0.01stake

# Blockchain RPC endpoint (for transaction broadcasting and chain state queries)
# Local development: http://localhost:26657
# Public testnet: consult your chain's documentation
CHAIN_RPC=http://localhost:26657

# Blockchain REST endpoint (alternative to RPC, used for some queries)
# Local development: http://localhost:1317
# Public testnet: consult your chain's documentation
CHAIN_REST=http://localhost:1317

# Broadcast mode for transactions: BROADCAST_MODE_SYNC, BROADCAST_MODE_ASYNC, BROADCAST_MODE_BLOCK
# SYNC: wait for transaction to be included in the mempool (recommended)
# ASYNC: return immediately without waiting
# BLOCK: wait for transaction to be included in a block (slowest)
BROADCAST_MODE=BROADCAST_MODE_SYNC

# Transaction confirmation timeout in milliseconds (how long to wait for confirmation)
TX_CONFIRM_TIMEOUT_MS=120000

# Polling interval when checking transaction status (in milliseconds)
TX_POLL_INTERVAL_MS=2000

# Interval for blockchain listener to poll for new blocks (in milliseconds)
BLOCKCHAIN_LISTENER_INTERVAL_MS=3000

# ───────────────────────────────────────────────────────────────────────────────
# Rate Limiting Configuration
# ───────────────────────────────────────────────────────────────────────────────

# Time window for rate limiting (in milliseconds)
# 60000 = 1 minute
RATE_LIMIT_WINDOW_MS=60000

# Maximum API requests per IP per window (120 requests/minute)
RATE_LIMIT_MAX=120

# Maximum transaction endpoint requests per IP per window (40 requests/minute)
# Lower than general API to prevent transaction spam
RATE_LIMIT_TX_MAX=40

# ───────────────────────────────────────────────────────────────────────────────
# Wallet Service Configuration (optional)
# ───────────────────────────────────────────────────────────────────────────────

# Enable wallet service (if false, wallet-specific endpoints are disabled)
WALLET_SERVICE_ENABLED=true

# Port for wallet service (separate service that can be on different host)
WALLET_SERVICE_PORT=4001

# Host to bind wallet service to (127.0.0.1 = localhost only)
WALLET_SERVICE_HOST=127.0.0.1

# ───────────────────────────────────────────────────────────────────────────────
# Faucet Configuration (for distributing test tokens on testnet)
# ───────────────────────────────────────────────────────────────────────────────
# WARNING: Never use mainnet accounts. These are testnet faucet credentials only.

# Private key for faucet account in hex format (only needed if FAUCET_ENABLED=true)
FAUCET_PRIVATE_KEY_HEX=REPLACE_WITH_LOCAL_DEV_FAUCET_PRIVATE_KEY_HEX

# Enable faucet endpoint for users to request test tokens
FAUCET_ENABLED=true

# Mnemonic (seed phrase) for faucet account (if not using private key)
# Should be a funded account on your testnet
FAUCET_MNEMONIC=REPLACE_WITH_FUNDED_TESTNET_MNEMONIC

# Amount of MLCNS to give per faucet request
FAUCET_MLCNS_AMOUNT=1000

# Amount of stake tokens to give per faucet request
FAUCET_STAKE_AMOUNT=100

# Maximum total MLCNS that can be distributed from faucet (total cap)
FAUCET_MAX_MLCNS=10000

# Cooldown between faucet requests per user (in milliseconds)
FAUCET_COOLDOWN_MS=60000

# Whether faucet should automatically fund transaction gas fees
FAUCET_FUND_GAS=true

# ───────────────────────────────────────────────────────────────────────────────
# Treasury and Operator Mnemonics (for server-side transaction signing)
# ───────────────────────────────────────────────────────────────────────────────
# WARNING: These are highly sensitive. Only set on secure, trusted nodes.
# NEVER commit these to git. Use secure secret management in production.

# Treasury account mnemonic (handles treasury operations)
TREASURY_MNEMONIC=REPLACE_WITH_TREASURY_MNEMONIC

# Operator account mnemonic (handles operator transactions)
OPERATOR_MNEMONIC=REPLACE_WITH_OPERATOR_MNEMONIC

# Allow operator mnemonic to be used for transaction signing (default: false for safety)
ALLOW_OPERATOR_MNEMONIC=false

# ───────────────────────────────────────────────────────────────────────────────
# Safaricom / M-Pesa Payment Integration (optional)
# ───────────────────────────────────────────────────────────────────────────────

# Safaricom API endpoint (sandbox for testing, production for live)
SAFARICOM_API=https://sandbox.safaricom.co.ke

# Safaricom Consumer Key (obtained from M-Pesa developer portal)
SAFARICOM_KEY=REPLACE_WITH_SAFARICOM_CONSUMER_KEY

# Safaricom Consumer Secret (obtained from M-Pesa developer portal)
SAFARICOM_SECRET=REPLACE_WITH_SAFARICOM_CONSUMER_SECRET

# Business short code (assigned by Safaricom, typically numeric)
BUSINESS_SHORT_CODE=174379

# M-Pesa passkey for STK push (authentication with Safaricom)
PASSKEY=REPLACE_WITH_SAFARICOM_PASSKEY

# Callback URL for M-Pesa STK push (where Safaricom posts transaction results)
CALLBACK_URL=http://localhost:4000/api/buy/mpesa/callback

# Callback URL for M-Pesa B2C payouts
PAYOUT_CALLBACK_URL=http://localhost:4000/api/buy/payout/callback

# B2C initiator name (identity for business-to-consumer transactions)
B2C_INITIATOR_NAME=testapi

# B2C security credential (encrypted password for B2C operations)
SECURITY_CREDENTIAL=REPLACE_WITH_B2C_SECURITY_CREDENTIAL

# B2C command ID (usually "BusinessPayment" or "SalaryPayment")
COMMAND_ID=BusinessPayment

# Enable automatic payout to users when they request withdrawals (default: false)
ENABLE_WITHDRAWAL_AUTO_PAYOUT=false

# Cashout receiver address (blockchain address where fees are collected)
# Example: mall1abc123def456...
CASHOUT_RECEIVER_ADDRESS=REPLACE_WITH_OPERATOR_OR_TREASURY_MALL_ADDRESS

# ───────────────────────────────────────────────────────────────────────────────
# Testing and Development
# ───────────────────────────────────────────────────────────────────────────────

# Test mode: disables some production guards and enables debug features
# Set to true only during development/testing, never in production
TEST_MODE=false
