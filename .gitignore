# Build outputs
dist/
build/
release/
coverage/

# Dependencies
node_modules/
**/node_modules/

# Environment files — never commit secrets
.env
.env.*
!.env.example

# MongoDB replica-set internal-auth keyfile (docker-compose.yml's mongo
# service) — a shared secret between replica-set members, generate your own
# per environment with: openssl rand -base64 756 > mongo-keyfile && chmod 400 mongo-keyfile
mongo-keyfile

# Logs and outputs
*.log
*.out
*.rdb

# Uploaded user content — never commit PII (KYC documents, etc.)
backend/uploads/

# OS files
.DS_Store
Thumbs.db

# IDEs
.vscode/
.idea/

# Go artifacts
*.exe
*.exe~
*.dll
*.so
*.dylib

# Temporary files
tmp/
temp/

# Local generated files
search_results.txt
go_env.txt
go_env_status.txt
go_list.out
go_mod_tidy.out
go_work_files.out
test_file.out
x_gomod_files.out
x_gomod_files.txt

# Validator and node private keys — NEVER commit these
blockchain_working/config/priv_validator_key.json
blockchain_working/config/node_key.json
blockchain_working/keyring-test/
blockchain_working/data/priv_validator_state.json
blockchain_working/config/gentx/

# Test/marketplace node keys
.marketplace_test/config/priv_validator_key.json
.marketplace_test/config/node_key.json
.marketplace_test/data/priv_validator_state.json

# Agent metadata - do not commit
.kilocode/
.kilo/
.kiro/
.mines/
.claude/

# Blockchain data (large, regeneratable — never commit)
blockchain_working/data/
blockchain_working/config/write-file-atomic-*
blockchain_working/config/*.bak
blockchain_working/config/*.bak-*

# Accidentally vendored Go toolchain source (not referenced by any build script)
go-src/

# Python cache
__pycache__/
*.pyc

# Compiled binary
marketplaced

# Backup files
backup-handwritten/

# Documentation
*.md
!README.md
!CONTRIBUTING.md
!CODE_OF_CONDUCT.md
!CHANGELOG.md
!SECURITY.md
!PRODUCTION.md
!docs/**
!API_REFERENCE.md
!TODO.md
!INSTALL.md

# Wallet data (sensitive)
wallet_data/

# Lighthouse CI local run artifacts (mallchain-os-v14/lighthouserc.cjs)
.lighthouseci/